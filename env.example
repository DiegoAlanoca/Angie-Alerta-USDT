# Copia este archivo como .env y completa los valores. NUNCA subas el .env a git.
# Token del bot: se obtiene hablando con @BotFather en Telegram.
TELEGRAM_TOKEN=
# Tu chat_id de Telegram (administrador del bot).
ADMIN_CHAT_ID=
# Opcional: enlace de donacion (p. ej. Binance Pay) que se muestra como boton en el bot. Debe empezar con https://
DONATION_URL=
